# Frontend Environment Variables (Vercel)
# In production on Vercel, set VITE_API_URL to your deployed Render backend URL:
# Example: https://marichifleet-backend.onrender.com/api
VITE_API_URL="https://your-backend-service.onrender.com/api"

# Google OAuth 2.0 Client ID for Frontend Sign-In
VITE_GOOGLE_CLIENT_ID="116103213980-jbatdnvs5ckpbamneisc4e8g66v0jgba.apps.googleusercontent.com"

# Mapbox Access Token for Fleet Maps & Live Tracking
VITE_MAPBOX_TOKEN="YOUR_MAPBOX_PUBLIC_TOKEN"

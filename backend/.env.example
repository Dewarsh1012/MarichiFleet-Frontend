# MarichiFleet OS Backend Environment Variables
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:8080,https://marichifleet.com
JWT_SECRET=marichifleet-super-secret-jwt-key-change-in-production

# MongoDB URI (Optional: If not provided or unreachable, backend runs on resilient in-memory tenant store)
MONGODB_URI=mongodb://localhost:27017/marichifleet

# Service Info
SERVICE_NAME=core-api
API_PREFIX=/api
